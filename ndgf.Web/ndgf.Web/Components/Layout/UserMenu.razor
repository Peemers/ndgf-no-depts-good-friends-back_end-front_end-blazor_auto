@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
  <Authorized>
    <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-sm sm:text-base">
      <span>Bonjour, @context.User.FindFirst("Pseudo")?.Value</span>
      <button @onclick="HandleLogout" class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded">
        Déconnexion
      </button>
    </div>
  </Authorized>
  <NotAuthorized>
    <div class="flex gap-4">
      <NavLink href="/login" class="hover:underline">Se connecter</NavLink>
      <NavLink href="/register" class="hover:underline">S'inscrire</NavLink>
    </div>
  </NotAuthorized>
</AuthorizeView>

@code {
  private void HandleLogout()
  {
    NavigationManager.NavigateTo("/auth/signout", forceLoad: true);
  }
}