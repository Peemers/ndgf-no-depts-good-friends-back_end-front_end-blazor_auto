@code {
  [Parameter] public Guid GroupId { get; set; }

  private GroupDetailResponseModel? _groupDetails;
  private GetGroupExpensesResponseModel? _getGroupExpenses;
  private GetGroupBalanceResponseModel? _getGroupBalance;
  private GetGroupHistoryResponseModel? _getGroupHistory;
  private string? _errorMessage;
  private bool _showAddMemberForm;
  private string? _message;
  private bool _isSubmiting;
  private bool _showExpenseModal;
  private void OpenExpenseModal() => _showExpenseModal = true;
  private void CloseExpenseModal() => _showExpenseModal = false;
  private bool _showRefundModal;
  private void OpenRefundModal() => _showRefundModal = true;
  private void CloseRefundModal() => _showRefundModal = false;
  private List<Guid> _selectedUserIds = new();
  private int _pageNumber = 1;
  private int _pageSize = 10;
  private bool _sortDescending = true;

  private AddGroupMemberModel _model = new()
  {
    SearchValue = ""
  };

  private CreateExpenseRequestModel _createExpenseModel = new()
  {
    Amount = 0,
    Description = "",
    UserId = Guid.Empty,
    ExpenseParts = new List<ExpensePartInputModel>()
  };

  private CreateRefundRequestModel _createRefundModel = new()
  {
    Amount = 0,
    PayerId = Guid.Empty,
    ReceiverId = Guid.Empty,
    Description = ""
  };

  private void ToggleAddMemberForm()
  {
    _showAddMemberForm = !_showAddMemberForm;
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadGroupDetailsAsync();
    await GetGroupExpenses();
    await GetGroupBalance();
    await GetGroupHistory();
  }

  private async Task LoadGroupDetailsAsync()
  {
    var response = await GroupApiClient.GetGroupDetailsAsync(GroupId);

    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger ce groupe";
      return;
    }

    _groupDetails = await response.Content.ReadFromJsonAsync<GroupDetailResponseModel>();
  }

  private async Task GetGroupExpenses()
  {
    var response = await ExpenseApiClient.GetGroupExpensesAsync(GroupId, _pageNumber, _pageSize, _sortDescending);
    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger les dépenses de ce groupe";
      return;
    }

    _getGroupExpenses = await response.Content.ReadFromJsonAsync<GetGroupExpensesResponseModel>();
  }

  private async Task GetGroupBalance()
  {
    var response = await ExpenseApiClient.GetGroupBalanceAsync(GroupId);
    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger la balance";
      return;
    }

    _getGroupBalance = await response.Content.ReadFromJsonAsync<GetGroupBalanceResponseModel>();
  }

  private async Task GetGroupHistory()
  {
    var response = await ExpenseApiClient.GetGroupHistoryAsync(GroupId, _pageNumber, _pageSize, _sortDescending);
    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger l'historique de dépense ET de remboursement";
      return;
    }

    _getGroupHistory = await response.Content.ReadFromJsonAsync<GetGroupHistoryResponseModel>();
  }

  private async Task HandleAddGroupMember()
  {
    _isSubmiting = true;

    try
    {
      var response = await GroupApiClient.AddGroupMemberAsync(_model, GroupId);

      if (!response.IsSuccessStatusCode)
      {
        var errorMessage = await response.Content.ReadAsStringAsync();
        _errorMessage = errorMessage;
        StateHasChanged();
        await Task.Delay(3000);
        _errorMessage = null;
        return;
      }

      _message = "Membre ajouté au groupe avec succes";
      _model = new AddGroupMemberModel { SearchValue = "" };
      _showAddMemberForm = false;

      await LoadGroupDetailsAsync();

      StateHasChanged();

      await Task.Delay(3000);
      _message = null;
    }
    finally
    {
      _isSubmiting = false;
    }
  }

  private void CalculatePartPerUser()
  {
    _createExpenseModel.ExpenseParts.Clear();

    var baseShare = 100 / _selectedUserIds.Count;
    var reminder = 100 % _selectedUserIds.Count;

    for (int i = 0; i < _selectedUserIds.Count; i++)
    {
      int percentage = (i == 0) ? baseShare + reminder : baseShare;
      _createExpenseModel.ExpenseParts.Add(new ExpensePartInputModel { UserId = _selectedUserIds[i], Percentage = percentage });
    }
  }

  private async Task HandleCreateExpense()
  {
    _isSubmiting = true;

    try
    {
      if (_selectedUserIds.Count == 0)
      {
        _errorMessage = "Veuillez selectionner au moins un participant";
        return;
      }

      CalculatePartPerUser();

      var response = await ExpenseApiClient.CreateExpenseAsync(_createExpenseModel, GroupId);

      if (!response.IsSuccessStatusCode)
      {
        var errorMessage = await response.Content.ReadAsStringAsync();
        _errorMessage = errorMessage;
        StateHasChanged();
        return;
      }

      await GetGroupBalance();
      await GetGroupHistory();
      _message = "Dépense créée avec succes";

      StateHasChanged();

      await Task.Delay(1000);
      _message = null;

      CloseExpenseModal();
    }
    finally
    {
      _isSubmiting = false;
      _createExpenseModel.ExpenseParts.Clear();
      _selectedUserIds.Clear();
    }
  }

  private async Task HandleCreateRefund()
  {
    _isSubmiting = true;

    try
    {
      var response = await RefundApiClient.CreateRefundAsync(_createRefundModel, GroupId);

      if (!response.IsSuccessStatusCode)
      {
        var errorMessage = await response.Content.ReadAsStringAsync();
        _errorMessage = errorMessage;
        StateHasChanged();
        await Task.Delay(3000);
        _errorMessage = null;
        return;
      }

      await GetGroupBalance();
      await GetGroupHistory();

      _message = "Remboursement bien effectué";

      StateHasChanged();

      await Task.Delay(3000);
      _message = null;

      CloseRefundModal();
    }
    finally
    {
      _isSubmiting = false;
    }
  }

  private async Task NextPage()
  {
    if (_getGroupHistory is not null && _pageNumber < _getGroupHistory.TransactionSummary.TotalPages)
    {
      _pageNumber++;

      await GetGroupHistory();
    }
  }

  private async Task PreviousPage()
  {
    if (_getGroupHistory is not null && _pageNumber > 1)
    {
      _pageNumber--;

      await GetGroupHistory();
    }
  }

  private void ToggleParticipant(Guid userId)
  {
    if (_selectedUserIds.Contains(userId))
    {
      _selectedUserIds.Remove(userId);
    }
    else
    {
      _selectedUserIds.Add(userId);
    }
  }

  private Guid? _transactionToDeleteId;
  private TransactionTypeModel? _transactionToDeleteType;

  private void RequestDelete(Guid id, TransactionTypeModel type)
  {
    _transactionToDeleteId = id;
    _transactionToDeleteType = type;
  }

  private void CancelDelete()
  {
    _transactionToDeleteId = null;
    _transactionToDeleteType = null;
  }

  private async Task ConfirmDelete()
  {
    if (_transactionToDeleteId is null || _transactionToDeleteType is null)
    {
      return;
    }

    HttpResponseMessage response;

    if (_transactionToDeleteType == TransactionTypeModel.Expense)
    {
      response = await ExpenseApiClient.DeleteExpenseAsync(GroupId, _transactionToDeleteId.Value);
    }
    else
    {
      response = await RefundApiClient.DeleteRefundAsync(GroupId, _transactionToDeleteId.Value);
    }

    if (response.IsSuccessStatusCode)
    {
      await GetGroupHistory();
      await GetGroupBalance();
      await GetGroupExpenses();
    }

    CancelDelete();
  }

  private bool _confirmExpense;

  private async Task RequestCreateExpense()
  {
    if (_selectedUserIds.Count == 0)
    {
      _errorMessage = "Veuillez selectionner au moins un participant à cette dépense";
      StateHasChanged();
      await Task.Delay(3000);
      _errorMessage = null;
      return;
    }

    CalculatePartPerUser();
    _confirmExpense = true;
  }

  private void CancelCreateExpense()
  {
    _confirmExpense = false;
  }

  private async Task ConfirmCreateExpense()
  {
    await HandleCreateExpense();

    await Task.Delay(1000);
    _message = null;

    _confirmExpense = false;
  }

  private bool _confirmRefund;

  private void RequestCreateRefund()
  {
    _confirmRefund = true;
  }

  private void CancelCreateRefund()
  {
    _confirmRefund = false;
  }

  private async Task ConfirmCreateRefund()
  {
    await HandleCreateRefund();
    await Task.Delay(2000);
    _message = null;

    _confirmRefund = false;
  }

  private bool _showMonthlyStats;
  private GetGroupExpensesByMonthResponseModel? _monthlyExpenses;

  private async Task LoadMonthlyExpenses()
  {
    var response = await ExpenseApiClient.GetGroupExpensesByMonthAsync(GroupId);
    if (response.IsSuccessStatusCode)
    {
      _monthlyExpenses = await response.Content.ReadFromJsonAsync<GetGroupExpensesByMonthResponseModel>();
    }
  }

  private async Task ToggleMonthlyStats()
  {
    _showMonthlyStats = !_showMonthlyStats;

    if (_showMonthlyStats)
    {
      await LoadMonthlyExpenses();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_showMonthlyStats && _monthlyExpenses is not null)
    {
      var labels = _monthlyExpenses.MonthlyExpenses
        .Select(m => $"{m.Month}/{m.Year}")
        .ToArray();

      var data = _monthlyExpenses.MonthlyExpenses
        .Select(m => m.Total)
        .ToArray();

      await JSRuntime.InvokeVoidAsync("renderMonthlyExpensesChart", "monthlyExpensesChart", labels, data);
    }
  }

  private bool _showArchiveConfirmation;

  private void RequestArchive()
  {
    _showArchiveConfirmation = true;
  }

  private void CancelArchive()
  {
    _showArchiveConfirmation = false;
  }

  private async Task ConfirmArchive()
  {
    var response = await GroupApiClient.ArchiveGroupAsync(GroupId);

    if (response.IsSuccessStatusCode)
    {
      NavigationManager.NavigateTo("/groups");
    }
    else
    {
      var errorMessage = await response.Content.ReadAsStringAsync();
      _errorMessage = errorMessage;
      StateHasChanged();
      await Task.Delay(3000);
      _errorMessage = null;
    }

    _showArchiveConfirmation = false;
  }

  private Guid? _memberToRemoveId;
  private string? _memberToRemovePseudo;

  private void RequestRemoveMember(Guid memberId, string pseudo)
  {
    _memberToRemoveId = memberId;
    _memberToRemovePseudo = pseudo;
  }

  private void CancelRemoveMember()
  {
    _memberToRemoveId = null;
    _memberToRemovePseudo = null;
  }

  private async Task ConfirmRemoveMember()
  {
    if (_memberToRemoveId is null)
    {
      return;
    }

    var response = await GroupApiClient.RemoveGroupMemberAsync(GroupId, _memberToRemoveId.Value);

    if (response.IsSuccessStatusCode)
    {
      await LoadGroupDetailsAsync();
      await GetGroupBalance();
    }
    else
    {
      var errorMessage = await response.Content.ReadAsStringAsync();
      _errorMessage = errorMessage;
      StateHasChanged();
      await Task.Delay(3000);
      _errorMessage = null;
    }

    _memberToRemoveId = null;
  }

  private static readonly string[] Colors =
  {
    "from-[#8A6220] to-[#6E5219]",
    "from-[#98492C] to-[#7A3A23]",
    "from-[#46392F] to-[#352A23]",
    "from-[#6A4A70] to-[#553A5A]",
    "from-[#4A5C86] to-[#3A4A6E]",
    "from-[#6E6B2A] to-[#575420]"
  };

  private static string GetColorForUser(Guid userId)
  {
    var index = Math.Abs(userId.GetHashCode()) % Colors.Length;
    return Colors[index];
  }

}