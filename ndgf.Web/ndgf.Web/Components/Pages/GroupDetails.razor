      <div class="flex justify-end gap-3">
        <button @onclick="CancelRemoveMember"
                class="text-[#46392F] bg-[#E8DECD] hover:bg-[#CFC2AF] active:bg-[#CFC2AF] hover:scale-98 active:scale-98 px-4 py-2 rounded-xl">
          Annuler
        </button>
        <button @onclick="ConfirmRemoveMember"
                class="text-[#F7F1E5] bg-[#A85434] hover:bg-[#8A4529] active:bg-[#8A4529] hover:scale-98 active:scale-98 px-4 py-2 rounded-xl">
          Retirer du groupe
        </button>
      </div>
