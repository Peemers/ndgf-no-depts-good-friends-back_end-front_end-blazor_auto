@page "/groups/{groupId:guid}"
@using Microsoft.AspNetCore.Authorization
@using ndgf.Domain.Entities
@using ndgf.Web.Models.Expense
@using ndgf.Web.Models.Group
@using ndgf.Web.Models.GroupHistory
@using ndgf.Web.Models.Refund
@using ndgf.Web.Services.Expense
@using ndgf.Web.Services.Group
@using ndgf.Web.Services.Refund
@inject GroupApiClient GroupApiClient
@inject ExpenseApiClient ExpenseApiClient
@inject RefundApiClient RefundApiClient
@inject NavigationManager NavigationManager

@attribute [Authorize]

<div class="min-h-screen flex flex-col md:flex-row bg-linear-to-bl from-[#F3EBD8] to-[#B07D4C]">

  @if (_errorMessage is not null)
  {
    <p class="text-center text-2xl text-red-600 p-6">@_errorMessage</p>
  }
  else if (_groupDetails is null)
  {
    <p class="text-center text-2xl p-6">Chargement en cours</p>
  }
  else
  {
    <div class="w-full text-2xl bg-white/70 p-6 shadow-lg md:w-80 md:sticky md:top-0 md:h-screen md:overflow-y-auto">

      <div class="flex justify-between items-center mb-1">
        <h2 class="text-xl font-semibold text-gray-800">Membres</h2>
        <span class="text-lg text-gray-500 bg-gray-200 px-2 py-0.5 rounded-full">@_groupDetails.Members.Count()</span>
      </div>

      <button @onclick="ToggleAddMemberForm"
              class="w-full mt-3 bg-linear-to-l rounded-xl shadow-black shadow-lg border-black from-amber-700 to-orange-800 text-white px-4 py-2 hover:from-green-600 hover:to-[#7B9668] flex items-center justify-center gap-2">
        <span>+</span> Ajouter un membre
      </button>

      @if (_showAddMemberForm)
      {
        <EditForm Model="_model" OnValidSubmit="HandleAddGroupMember"
                  class="p-3 mt-3 bg-amber-50 rounded-xl flex flex-col items-center">
          <DataAnnotationsValidator/>
          <h3 class="mb-2 font-bold text-sm text-gray-700">Rechercher un membre à ajouter</h3>

          <div class="w-full">
            <InputText @bind-Value="_model.SearchValue" class="border border-gray-400 rounded-xl p-3 mb-2 w-full"/>
            <ValidationMessage For="() => _model.SearchValue" class="text-s mb-2 text-red-800"/>
          </div>

          <button type="submit" disabled="@_isSubmiting"
                  class="bg-linear-to-l rounded-2xl border-b-black from-amber-700 to-orange-800 text-white hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 w-full p-2 shadow-black shadow-lg">
            @if (_isSubmiting)
            {
              <span>Ajout en cours ...</span>
            }
            else
            {
              <span>Ajouter membre</span>
            }
          </button>
        </EditForm>
      }

      @if (_message is not null)
      {
        <p class="text-green-900 mt-4 text-sm">@_message</p>
      }

      <div
        class="flex flex-row md:flex-col flex-wrap gap-0 md:gap-2 md:mt-6 border-t border-gray-400 pt-4 md:pt-4 items-center md:items-start">
        @foreach (var member in _groupDetails.Members)
        {
          <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-amber-50">
            <div
              class="w-10 h-10 md:w-25 md:h-25 shrink-0 rounded-full shadow-md bg-linear-to-t from-amber-700 to-amber-900 text-white flex items-center justify-center text-sm font-bold">
              @member.Pseudo[0]@member.Pseudo[1]@member.Pseudo[2]
            </div>
            <div class="min-w-0">
              <p class="font-bold text-lg md:text-2xl text-gray-800">@member.Pseudo</p>
              <p class="text-lg text-gray-500">@member.Email</p>
            </div>
            <button @onclick="() => RequestRemoveMember(member.UserId, member.Pseudo)"
                    class="text-gray-400 hover:bg-red-600 active:text-red-600 border rounded-full bg-red-400 text-white p-0.5">
              ✕
            </button>
          </div>
        }
      </div>
    </div>


    <div class="flex-1 p-3">
      <div class="bg-linear-to-br from-white to-violet-200 shadow-2xl rounded-2xl p-6 min-h-screen max-w-screen">
        <h1 class="text-4xl font-bold text-center md:text-left">@_groupDetails.Name</h1>
        @if (_groupDetails.Description is not null)
        {
          <p class="text-gray-500 text-xl mt-2 text-center md:text-left">@_groupDetails.Description</p>
        }

        <div class="flex flex-col md:flex-row gap-6 mt-4">
          <div class="w-full md:flex-1 bg-white/60 rounded-2xl p-4 border border-amber-200">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xl">💡</span>
              <h3 class="text-lg font-semibold text-gray-800">Remboursements suggérés</h3>
            </div>

            @if (_getGroupBalance is not null && _getGroupBalance.SuggestedRepayments.Any())
            {
              <div class="space-y-2">
                @foreach (var repayment in _getGroupBalance.SuggestedRepayments)
                {
                  <div class="flex items-center gap-3 p-3 rounded-xl bg-amber-50 border border-amber-200">
                    <div
                      class="w-9 h-9 rounded-full bg-amber-700 text-white flex items-center justify-center text-xs font-bold shrink-0">
                      @repayment.PayerPseudo[0]@repayment.PayerPseudo[1]
                    </div>
                    <p class="text-base leading-snug">
                      <span class="font-semibold">@repayment.PayerPseudo</span> doit
                      <span class="font-semibold text-amber-800">@repayment.Amount €</span>
                      à <span class="font-semibold">@repayment.ReceiverPseudo</span>
                    </p>
                  </div>
                }
              </div>
            }
            else
            {
              <p class="text-gray-500 mb-4 text-lg italic">Tout le monde est à jour, rien à régler.</p>
            }
          </div>


          <div class="w-full md:flex-1 bg-white/60 rounded-2xl p-4 border border-violet-200">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xl">📊</span>
              <h3 class="text-lg font-semibold text-gray-800">Soldes du groupe</h3>
            </div>

            @if (_getGroupBalance is not null && _getGroupBalance.Balances.Any())
            {
              <div class="space-y-2">
                @foreach (var balance in _getGroupBalance.Balances)
                {
                  <div class="flex justify-between items-center p-3 rounded-xl bg-white border border-gray-200">
                    <p class="font-semibold">@balance.Pseudo</p>

                    @if (balance.Balance > 0)
                    {
                      <span
                        class="text-sm font-semibold text-green-700 bg-green-100 px-2 py-1 rounded-full">+@balance.Balance €</span>
                    }
                    else if (balance.Balance < 0)
                    {
                      <span
                        class="text-sm font-semibold text-red-700 bg-red-100 px-2 py-1 rounded-full">@balance.Balance €</span>
                    }
                    else
                    {
                      <span class="text-sm font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded-full">À jour</span>
                    }
                  </div>
                }
              </div>
            }
            else
            {
              <p class="text-gray-500 text-sm italic">Aucun solde à afficher.</p>
            }
          </div>
        </div>

        <div
          class="flex flex-col md:flex-row justify-between items-center mt-2 p-3 rounded-xl gap-2 w-full">
          @if (_getGroupBalance is not null)
          {
            <div class="bg-white/70 rounded-xl p-3 shadow-sm flex flex-row items-center gap-2">
              <p class="text-gray-700 text-xl">
                @_getGroupBalance?.ExpenseCount dépense(s) au total
              </p>
              <span class="text-gray-400">•</span>
              <p class="text-gray-700 text-xl">pour une somme de <span
                  class="text-orange-950 font-semibold">@_getGroupBalance?.TotalExpenses</span> € dépensée</p>
            </div>
          }

          <div class="flex flex-col md:flex-row items-center bg-gray-200 p-2 mt-2 rounded-xl gap-2">

            <button @onclick="RequestArchive"
                    class="bg-linear-to-r text-center rounded-2xl  shadow-black shadow-sm from-red-200 to-red-400 text-black hover:bg-linear-to-r hover:from-red-600 hover:to-red-700 active:from-red-500 active:to-red-600 px-4 py-2 text-xl">
              🔒Archiver le groupe
            </button>

            <NavLink href="/groups"
                     class="bg-linear-to-r text-center rounded-2xl  shadow-black shadow-sm from-amber-100 to-orange-300 text-black hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 px-4 py-2 text-xl">
              🔙 Retour aux groupes
            </NavLink>

            <button @onclick="OpenExpenseModal"
                    class="bg-linear-to-l rounded-2xl shadow-black shadow-sm from-amber-700 to-orange-800 text-white hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 px-4 py-2 text-xl">
              ➕ Créer une nouvelle dépense
            </button>

            <button @onclick="OpenRefundModal"
                    class="bg-linear-to-l rounded-2xl shadow-black shadow-sm from-amber-700 to-orange-800 text-white hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 px-4 py-2 text-xl">
              ➕ Créer un nouveau remboursement
            </button>
          </div>

        </div>


        <div class="bg-gray-200 rounded-2xl">
          @if (_getGroupHistory is not null && _getGroupHistory.TransactionSummary.Items.Any())
          {
            <div class="mt-6 p-3 divide-y divide-gray-400">
              @foreach (var transaction in _getGroupHistory.TransactionSummary.Items)
              {
                <div
                  class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 py-4 @(transaction.DeletedAt is not null ? "opacity-40" : "")">
                  <div class="min-w-0">
                    @if (transaction.Transaction == TransactionTypeModel.Expense)
                    {
                      <p class="text-xl font-semibold text-red-600 truncate">💸 @transaction.Description</p>
                      <p class="text-lg text-gray-600">Payé par <span
                          class="font-semibold">@transaction.MainActorPseudo</span></p>
                    }
                    else
                    {
                      <p class="text-xl font-semibold text-green-700 truncate">
                        💰 @(string.IsNullOrWhiteSpace(transaction.Description) ? "Remboursement" : transaction.Description)</p>
                      <p class="text-lg text-gray-600">Remboursé
                        par <span class="font-semibold">@transaction.MainActorPseudo</span> vers <span
                          class="font-semibold">@transaction.ReceiverPseudo</span></p>
                    }
                  </div>
                  <div
                    class="flex flex-row sm:flex-col justify-between sm:justify-center sm:items-end sm:divide-y sm:divide-amber-800 sm:mr-2 shrink-0">
                    <div>
                      @if (transaction.DeletedAt is null)
                      {
                        <button @onclick="() => RequestDelete(transaction.Id, transaction.Transaction)"
                                class="bg-red-300 p-0.5 hover:bg-red-600 rounded-2xl active:bg-red-500 mb-1">
                          🗑️
                        </button>
                      }
                    </div>
                    @if (transaction.Transaction == TransactionTypeModel.Expense)
                    {
                      <p class="font-bold text-red-500">@transaction.Amount€</p>
                    }
                    else
                    {
                      <p class="font-bold text-green-500">@transaction.Amount€</p>
                    }
                    <p
                      class="text-sm font-semibold text-gray-800">@transaction.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                  </div>
                </div>
              }
            </div>
          }
          else
          {
            <p class="mt-4 text-center text-2xl pt-6">Pas d'historique à afficher dans ce groupe</p>
            <div class="flex justify-center p-3 h-fit">
              <img src="images/notfound.jpg" alt="NotFoundImage" class="w-lg p-3 opacity-40">
            </div>
          }
        </div>

        @if (_showExpenseModal)
        {
          <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
            <div class="bg-white rounded-2xl p-6 max-w-md w-full">
              <EditForm Model="_createExpenseModel" OnValidSubmit="HandleCreateExpense" class="space-y-4">
                <DataAnnotationsValidator/>
                <div class="flex justify-end">
                  <button type="button" @onclick="CloseExpenseModal"
                          class="bg-gray-300 hover:bg-green-200 active:bg-green-300 flex text-xl underline"> fermer
                  </button>
                </div>
                <h1 class="text-2xl font-bold mb-6 flex underline">Création d'une nouvelle dépense</h1>

                @if (_message is not null)
                {
                  <p class="mb-4 text-xl text-green-500">@_message</p>
                }

                <div>
                  <label class="text-xl">Montant dépensé</label>
                  <InputNumber @bind-Value="_createExpenseModel.Amount"
                               class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1"/>
                  <ValidationMessage For="() => _createExpenseModel.Amount"/>
                </div>

                <div>
                  <label class="text-xl">Déscription de la dépense</label>
                  <InputText @bind-Value="_createExpenseModel.Description"
                             class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1"/>
                  <ValidationMessage For="() => _createExpenseModel.Description"/>
                </div>

                <div>
                  <label class="text-xl">Qui a fait cette dépense ?</label>
                  <InputSelect @bind-Value="_createExpenseModel.UserId"
                               class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1">
                    <option value="">Choisir un membre du groupe</option>
                    @foreach (var member in _groupDetails.Members)
                    {
                      <option value="@member.UserId">@member.Pseudo</option>
                    }
                  </InputSelect>
                </div>


                <label class="text-xl">Qui participe à cette dépense ?</label>

                <div class="mt-3">
                  @foreach (var member in _groupDetails.Members)
                  {
                    <div class="flex p-2 mb-1 w-fit items-center bg-[#B07D4C]/50 rounded-2xl">
                      <input class="ml-2 mr-2" type="checkbox"
                             checked="@_selectedUserIds.Contains(member.UserId)"
                             @onchange="() => ToggleParticipant(member.UserId)"/>
                      <label class="text-xl">@member.Pseudo - @member.Email</label>
                    </div>
                  }
                </div>

                <div class="flex">
                  <button type="submit" disabled="@_isSubmiting"
                          class="mr-1 bg-linear-to-l rounded-2xl from-amber-700 to-orange-800 text-white hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 px-4 py-2 text-xl mt-1 w-full">
                    @if (_isSubmiting)
                    {
                      <span>Création en cours ...</span>
                    }
                    else
                    {
                      <span>Créer la dépense</span>
                    }
                  </button>
                  <button type="button" @onclick="CloseExpenseModal"
                          class="bg-linear-to-l rounded-2xl from-red-400 to-red-500 text-white hover:bg-linear-to-r hover:from-red-600 hover:to-red-700 active:from-red-700 active:to-red-800 px-4 py-2 text-xl mt-4 w-full">
                    Annuler
                  </button>
                </div>
              </EditForm>
            </div>
          </div>
        }
        @if (_showRefundModal)
        {
          <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
            <div class="bg-white rounded-2xl p-6 max-w-md w-full">
              <EditForm Model="_createRefundModel" OnValidSubmit="HandleCreateRefund" class="space-y-4">
                <DataAnnotationsValidator/>
                <div class="flex justify-end">
                  <button type="button" @onclick="CloseRefundModal"
                          class="bg-gray-300 hover:bg-green-200 active:bg-green-300 flex text-xl underline"> fermer
                  </button>
                </div>
                <h1 class="text-2xl font-bold mb-6 flex underline">Création d'un remboursement</h1>

                @if (_message is not null)
                {
                  <p class="mb-4 text-xl text-green-500">@_message</p>
                }

                <div>
                  <label class="text-xl">Montant remboursé</label>
                  <InputNumber @bind-Value="_createRefundModel.Amount"
                               class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1"/>
                  <ValidationMessage For="() => _createRefundModel.Amount"/>
                </div>

                <div>
                  <label class="text-xl">Déscription du remboursement (optionnel)</label>
                  <InputText @bind-Value="_createRefundModel.Description"
                             class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1"/>
                  <ValidationMessage For="() => _createRefundModel.Description"/>
                </div>

                <div>
                  <label class="text-xl">Qui rembourse cet argent ?</label>
                  <InputSelect @bind-Value="_createRefundModel.PayerId"
                               class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1">
                    <option value="">Choisir un membre du groupe</option>
                    @foreach (var member in _groupDetails.Members)
                    {
                      <option value="@member.UserId">@member.Pseudo</option>
                    }
                  </InputSelect>
                </div>

                <div>
                  <label class="text-xl">Qui reçoit cet argent ?</label>
                  <InputSelect @bind-Value="_createRefundModel.ReceiverId"
                               class="border border-gray-300 rounded-xl p-3 w-full text-xl mt-1">
                    <option value="">Choisir un membre du groupe</option>
                    @foreach (var member in _groupDetails.Members)
                    {
                      <option value="@member.UserId">@member.Pseudo</option>
                    }
                  </InputSelect>
                </div>

                <div class="flex">
                  <button type="submit" disabled="@_isSubmiting"
                          class="mr-1 bg-linear-to-l rounded-2xl from-amber-700 to-orange-800 text-white hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 px-4 py-2 text-xl mt-1 w-full">
                    @if (_isSubmiting)
                    {
                      <span>Remboursement ...</span>
                    }
                    else
                    {
                      <span>Valider Remboursement</span>
                    }
                  </button>
                  <button type="button" @onclick="CloseRefundModal"
                          class="bg-linear-to-l rounded-2xl from-red-400 to-red-500 text-white hover:bg-linear-to-r hover:from-red-600 hover:to-red-700 active:from-red-600 active:to-red-700 px-4 py-2 text-xl mt-4 w-full">
                    Annuler
                  </button>
                </div>
              </EditForm>
            </div>
          </div>
        }
      </div>
      @if (_getGroupExpenses is not null && _getGroupExpenses.Expenses.Items.Any())
      {
        <div
          class="justify-between font-semibold text-xl items-center border bg-linear-to-tr from-white to-violet-200 border-gray-300 p-2 rounded-lg flex gap-2 mt-2">
          <button @onclick="PreviousPage"
                  class="border border-gray-500 rounded-lg p-2 flex-1 bg-gray-300 bg-linear-to-l hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 text-center">
            ◀️ page précédente
          </button>
          <p class="bg-gray-300 border border-gray-500 rounded-lg p-2 flex-1 text-center">Page
            : @_getGroupExpenses.Expenses.PageNumber</p>
          <button @onclick="NextPage"
                  class="border border-gray-500 rounded-lg p-2 flex-1 bg-gray-300 bg-linear-to-br hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 text-center">
            ▶️ page suivante
          </button>
        </div>
      }
    </div>
  }
</div>
@if (_transactionToDeleteId is not null)
{
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <h2 class="text-xl font-bold mb-4">Confirmer la suppression</h2>
      @if (_message is not null)
      {
        <p class="text-center text-sm text-red-600 p-6">@_message</p>
      }
      <p class="text-gray-600 mb-6">
        Êtes-vous sûr de vouloir supprimer cette
        @(_transactionToDeleteType == TransactionTypeModel.Expense ? "dépense" : "remboursement") ?
        Elle restera visible dans l'historique mais ne comptera plus dans les calculs.
      </p>
      <div class="flex justify-end gap-3">
        <button @onclick="CancelDelete"
                class="px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-100">
          Annuler
        </button>
        <button @onclick="ConfirmDelete"
                class="px-4 py-2 rounded-xl bg-red-600 text-white hover:bg-red-700">
          Supprimer
        </button>
      </div>
    </div>
  </div>
}
@if (_showArchiveConfirmation)
{
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <h2 class="text-xl font-bold mb-4">Confirmer l'archivage</h2>
      @if (_message is not null)
      {
        <p class="text-center text-sm text-red-600 p-6">@_message</p>
      }
      <p class="text-gray-600 mb-6">
        Êtes-vous sûr de vouloir archiver ce groupe : 
        @(_groupDetails?.Name) ?
        Il restera visible sur la page des groupes.
      </p>
      <div class="flex justify-end gap-3">
        <button @onclick="CancelArchive"
                class="px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-100">
          Annuler
        </button>
        <button @onclick="ConfirmArchive"
                class="px-4 py-2 rounded-xl bg-red-600 text-white hover:bg-red-700">
          Archiver
        </button>
      </div>
    </div>
  </div>
}

@if (_memberToRemoveId is not null)
{
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <h2 class="text-xl font-bold mb-4">Confirmer la suppression du membre</h2>
      @if (_message is not null)
      {
        <p class="text-center text-sm text-red-600 p-6">@_message</p>
      }
      <p class="text-gray-600 mb-6">
        Êtes-vous sûr de vouloir supprimer l'utilisateur : 
        @_memberToRemovePseudo du groupe ?
      </p>
      <div class="flex justify-end gap-3">
        <button @onclick="CancelRemoveMember"
                class="px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-100">
          Annuler
        </button>
        <button @onclick="ConfirmRemoveMember"
                class="px-4 py-2 rounded-xl bg-red-600 text-white hover:bg-red-700">
          Retirer du groupe
        </button>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public Guid GroupId { get; set; }

  private GroupDetailResponseModel? _groupDetails;
  private GetGroupExpensesResponseModel? _getGroupExpenses;
  private GetGroupBalanceResponseModel? _getGroupBalance;
  private GetGroupHistoryResponseModel? _getGroupHistory;
  private string? _errorMessage;
  private bool _showAddMemberForm;
  private string? _message;
  private bool _isSubmiting;
  private bool _showExpenseModal;
  private void OpenExpenseModal() => _showExpenseModal = true;
  private void CloseExpenseModal() => _showExpenseModal = false;
  private bool _showRefundModal;
  private void OpenRefundModal() => _showRefundModal = true;
  private void CloseRefundModal() => _showRefundModal = false;
  private List<Guid> _selectedUserIds = new();
  private int _pageNumber = 1;
  private int _pageSize = 10;
  private bool _sortDescending = true;

  private AddGroupMemberModel _model = new()
  {
    SearchValue = ""
  };

  private CreateExpenseRequestModel _createExpenseModel = new()
  {
    Amount = 0,
    Description = "",
    UserId = Guid.Empty,
    ExpenseParts = new List<ExpensePartInputModel>()
  };

  private CreateRefundRequestModel _createRefundModel = new()
  {
    Amount = 0,
    PayerId = Guid.Empty,
    ReceiverId = Guid.Empty,
    Description = ""
  };

  private void ToggleAddMemberForm()
  {
    _showAddMemberForm = !_showAddMemberForm;
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadGroupDetailsAsync();
    await GetGroupExpenses();
    await GetGroupBalance();
    await GetGroupHistory();
  }

  private async Task LoadGroupDetailsAsync()
  {
    var response = await GroupApiClient.GetGroupDetailsAsync(GroupId);

    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger ce groupe";
      return;
    }

    _groupDetails = await response.Content.ReadFromJsonAsync<GroupDetailResponseModel>();
  }

  private async Task GetGroupExpenses()
  {
    var response = await ExpenseApiClient.GetGroupExpensesAsync(GroupId, _pageNumber, _pageSize, _sortDescending);
    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger les dépenses de ce groupe";
      return;
    }

    _getGroupExpenses = await response.Content.ReadFromJsonAsync<GetGroupExpensesResponseModel>();
  }

  private async Task GetGroupBalance()
  {
    var response = await ExpenseApiClient.GetGroupBalanceAsync(GroupId);
    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger la balance";
      return;
    }

    _getGroupBalance = await response.Content.ReadFromJsonAsync<GetGroupBalanceResponseModel>();
  }

  private async Task GetGroupHistory()
  {
    var response = await ExpenseApiClient.GetGroupHistoryAsync(GroupId, _pageNumber, _pageSize, _sortDescending);
    if (!response.IsSuccessStatusCode)
    {
      _errorMessage = "Impossible de charger l'historique de dépense ET de remboursement";
      return;
    }

    _getGroupHistory = await response.Content.ReadFromJsonAsync<GetGroupHistoryResponseModel>();
  }

  private async Task HandleAddGroupMember()
  {
    _isSubmiting = true;

    try
    {
      var response = await GroupApiClient.AddGroupMemberAsync(_model, GroupId);

      if (!response.IsSuccessStatusCode)
      {
        _message = "Membre inexistant";
        StateHasChanged();
        await Task.Delay(3000);
        _message = null;
        return;
      }

      _message = "Membre ajouté au groupe avec succes";
      _model = new AddGroupMemberModel { SearchValue = "" };
      _showAddMemberForm = false;

      await LoadGroupDetailsAsync();

      StateHasChanged();

      await Task.Delay(3000);
      _message = null;
    }
    finally
    {
      _isSubmiting = false;
    }
  }

  private void CalculatePartPerUser()
  {
    var baseShare = 100 / _selectedUserIds.Count;
    var reminder = 100 % _selectedUserIds.Count;

    for (int i = 0; i < _selectedUserIds.Count; i++)
    {
      int percentage = (i == 0) ? baseShare + reminder : baseShare;
      _createExpenseModel.ExpenseParts.Add(new ExpensePartInputModel { UserId = _selectedUserIds[i], Percentage = percentage });
    }
  }

  private async Task HandleCreateExpense()
  {
    _isSubmiting = true;

    try
    {
      if (_selectedUserIds.Count == 0)
      {
        _message = "Veuillez selectionner au moins un participant";
        return;
      }

      CalculatePartPerUser();

      var response = await ExpenseApiClient.CreateExpenseAsync(_createExpenseModel, GroupId);

      if (!response.IsSuccessStatusCode)
      {
        _message = "Erreur lors de la création de la dépense";
        return;
      }

      await GetGroupBalance();
      await GetGroupHistory();
      _message = "Dépense créée avec succes";

      StateHasChanged();

      await Task.Delay(3000);
      _message = null;

      CloseExpenseModal();
    }
    finally
    {
      _isSubmiting = false;
      _createExpenseModel.ExpenseParts.Clear();
      _selectedUserIds.Clear();
    }
  }

  private async Task HandleCreateRefund()
  {
    _isSubmiting = true;

    try
    {
      var response = await RefundApiClient.CreateRefundAsync(_createRefundModel, GroupId);

      if (!response.IsSuccessStatusCode)
      {
        _message = "Erreur lors de la création du remboursement";
        return;
      }

      await GetGroupBalance();
      await GetGroupHistory();

      _message = "Remboursement bien effectué";

      StateHasChanged();

      await Task.Delay(3000);
      _message = null;

      CloseRefundModal();
    }
    finally
    {
      _isSubmiting = false;
    }
  }

  private async Task NextPage()
  {
    if (_getGroupHistory is not null && _pageNumber < _getGroupHistory.TransactionSummary.TotalPages)
    {
      _pageNumber++;
      await GetGroupHistory();
    }
  }

  private async Task PreviousPage()
  {
    if (_getGroupHistory is not null && _pageNumber > 1)
    {
      _pageNumber--;
      await GetGroupHistory();
    }
  }

  private void ToggleParticipant(Guid userId)
  {
    if (_selectedUserIds.Contains(userId))
    {
      _selectedUserIds.Remove(userId);
    }
    else
    {
      _selectedUserIds.Add(userId);
    }
  }

  private Guid? _transactionToDeleteId;
  private TransactionTypeModel? _transactionToDeleteType;

  private void RequestDelete(Guid id, TransactionTypeModel type)
  {
    _transactionToDeleteId = id;
    _transactionToDeleteType = type;
  }

  private void CancelDelete()
  {
    _transactionToDeleteId = null;
    _transactionToDeleteType = null;
  }

  private async Task ConfirmDelete()
  {
    if (_transactionToDeleteId is null || _transactionToDeleteType is null)
    {
      return;
    }

    HttpResponseMessage response;

    if (_transactionToDeleteType == TransactionTypeModel.Expense)
    {
      response = await ExpenseApiClient.DeleteExpenseAsync(GroupId, _transactionToDeleteId.Value);
    }
    else
    {
      response = await RefundApiClient.DeleteRefundAsync(GroupId, _transactionToDeleteId.Value);
    }

    if (response.IsSuccessStatusCode)
    {
      await GetGroupHistory();
      await GetGroupBalance();
      await GetGroupExpenses();
    }

    CancelDelete();
  }

  private bool _showArchiveConfirmation;

  private void RequestArchive()
  {
    _showArchiveConfirmation = true;
  }

  private void CancelArchive()
  {
    _showArchiveConfirmation = false;
  }

  private async Task ConfirmArchive()
  {
    var response = await GroupApiClient.ArchiveGroupAsync(GroupId);

    if (response.IsSuccessStatusCode)
    {
      NavigationManager.NavigateTo("/groups");
    }
    else
    {
      _message = "Impossible d'archiver ce groupe car il n'est pas soldé";
      StateHasChanged();
      await Task.Delay(3000);
      _message = null;
    }

    _showArchiveConfirmation = false;
  }

  private Guid? _memberToRemoveId;
  private string? _memberToRemovePseudo;

  private void RequestRemoveMember(Guid memberId, string pseudo)
  {
    _memberToRemoveId = memberId;
    _memberToRemovePseudo = pseudo;
  }

  private void CancelRemoveMember()
  {
    _memberToRemoveId = null;
    _memberToRemovePseudo = null;
  }

  private async Task ConfirmRemoveMember()
  {
    if (_memberToRemoveId is null)
    {
      return;
    }

    var response = await GroupApiClient.RemoveGroupMemberAsync(GroupId, _memberToRemoveId.Value);

    if (response.IsSuccessStatusCode)
    {
      await LoadGroupDetailsAsync();
      await GetGroupBalance();
    }
    else
    {
      var errorMessage = await response.Content.ReadAsStringAsync();
      _message = errorMessage;
      StateHasChanged();
      await Task.Delay(3000);
      _message = null;
    }

    _memberToRemoveId = null;
  }

}