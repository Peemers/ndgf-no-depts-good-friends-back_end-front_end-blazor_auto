{
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="text-[#2E2620] bg-[#F7F1E5] rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <h2 class="text-2xl font-bold mb-4">Confirmer la suppression du membre</h2>
      @if (_errorMessage is not null)
      {
        <p class="text-center text-sm text-red-800 p-6">@_errorMessage</p>
