@if (_confirmExpense)
{
  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <h2 class="text-2xl text-center font-bold mb-6 text-[#2E2620]">Résumé de la dépense à ajouter</h2>
      @if (_errorMessage is not null)
      {
        <p class="text-center rounded2--- text-sm text-red-800 p-6">@_errorMessage</p>
      }
      @if (_message is not null)
      {
        <p class="text-center rounded2--- text-sm text-green-800 p-6">@_message</p>
      }
      <p class="text-[#6E5C4E] mb-2">Montant : <span class="font-bold">@_createExpenseModel.Amount€</span></p>

      <p class="text-[#6E5C4E] mb-2"> Déscription : <span class="font-bold">@_createExpenseModel.Description</span></p>

      <p class="text-[#6E5C4E] mb-2">
        Qui a dépensé ? <span
          class="font-bold">@_groupDetails!.Members.FirstOrDefault(m => m.UserId == _createExpenseModel.UserId)?.Pseudo</span>
      </p>

      <p class="text-[#6E5C4E] mb-2">Qui participe ?</p>
      @foreach (var part in _createExpenseModel.ExpenseParts)
      {
        var member = _groupDetails!.Members.FirstOrDefault(m => m.UserId == part.UserId);
        <p class="mb-1"><span class="font-bold text-[#6E5C4E]">@member?.Pseudo</span> - @part.Percentage%</p>
      }

      <div class="flex justify-end gap-2">
        <button @onclick="CancelCreateExpense"
                class="text-[#46392F] bg-[#E8DECD] hover:bg-[#CFC2AF] active:bg-[#CFC2AF] hover:scale-98 active:scale-98 px-4 py-2 rounded-xl">
          Annuler
        </button>
        <button @onclick="ConfirmCreateExpense"
                class="bg-[#3D5A45] hover:bg-[#2F4436] active:bg-[#2F4436] text-[#E8DECD] hover:scale-97 active:scale-97 transition-all  px-4 py-2 rounded-xl">
          Confirmer
        </button>
      </div>
    </div>
  </div>
}

