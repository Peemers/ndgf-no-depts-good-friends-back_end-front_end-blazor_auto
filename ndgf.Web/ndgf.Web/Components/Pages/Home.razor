@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@layout MainLayout



<div class="min-h-screen w-full bg-[#F5F3EE] flex items-center justify-center p-6">

  <div
    class="w-full max-w-6xl border border-amber-200 bg-white rounded-3xl ring-1 ring-black/5 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.25)] overflow-hidden grid md:grid-cols-2">


    <div class="p-6 md:p-14 flex flex-col justify-center border-t-4 md:border-t-0 md:border-l-4 border-[#3D5A45]">
      <h1 class="text-3xl sm:text-4xl md:text-6xl font-black tracking-tight text-[#1E1813] leading-[1.05] mb-6">
        Bienvenue
      </h1>

      <p class="text-[#46392F] text-lg max-w-sm mb-10">
        Suivez, partagez et équilibrez vos dépenses de groupe en un coup d'œil.
      </p>

      <AuthorizeView>
        <Authorized>
          <NavLink href="/groups"
                   class="bg-[#3D5A45] hover:bg-[#2F4436] text-white active:scale-[0.95] transition-all text-center shadow-[#46392F] shadow-sm font-semibold rounded-lg h-14 px-8 text-base w-fit inline-flex items-center justify-center">
            Consultez vos groupes de dépense
          </NavLink>
        </Authorized>
        <NotAuthorized>
          <div>
            <NavLink href="/login"
                     class="bg-[#3D5A45] hover:bg-[#2F4436] active:scale-[0.95] transition-all text-white font-semibold rounded-lg py-3 px-8 text-sm sm:text-base w-full shadow-lg shadow-[#46392F] inline-flex items-center justify-center text-center">
              Connectez-vous
            </NavLink>
          </div>
          <div class="flex gap-4 p-1 mt-3 text-[#46392F]">
            <p>Pas encore inscrit ?</p>
            <NavLink href="/register"
                     class=" font-semibold  py-3 px-8 text-sm sm:text-base w-full inline-flex justify-end text-center text-[#C4953C] active:text-[#A87A2C] hover:underline">
              Créer un compte
            </NavLink>
          </div>
        </NotAuthorized>
      </AuthorizeView>
    </div>

    <div class="relative h-72 md:h-auto bg-neutral-100 flex items-center justify-center">
      <img src="images/ngdf4-crop.jpg" alt=""
           class="w-full h-full object-contain">
    </div>
  </div>
</div>




