@page "/login"
@layout AuthLayout
@using ndgf.Web.Models.User
@using ndgf.Web.Services.User
@inject UserApiClient UserApiCLient
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<div
  class="min-h-screen flex flex-row bg-linear-to-bl from-[#F3EBD8] to-[#B07D4C] p-2 items-center justify-center border-2">
  <div class="border rounded-2xl flex-row flex p-3 bg-linear-to-br from-white to-violet-200 shadow-2xl">
    <img src="images/ngdf3.jpg" alt="image de personne en train de faire leurs comptes"
         class="border rounded-2xl hidden md:block shadow-xl mr-2 w-auto">

    <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" class="space-y-4">
      <DataAnnotationsValidator/>
      <h1 class="text-3xl font-bold mb-6 flex text-center justify-center">Formulaire de connexion</h1>
      @if (_message is not null)
      {
        <p class="mb-4 text-lg text-red-600">@_message</p>
      }

      <div>
        <label class="text-xl">Email</label>
        <InputText @bind-Value="_model.Email" class="border border-gray-400 rounded-xl p-2 w-full text-xl mt-1"/>
        <ValidationMessage For="() => _model.Email"/>
      </div>
      
      <label class="text-xl">Mot de passe</label>
      <div class="relative">
        <input type="@(_showPassword ? "text" : "password")" @bind="_model.Password" @bind:event="oninput"
               class="border border-gray-400 rounded-xl p-2 pr-10 w-full text-xl mt-1"/>
        <button type="button" @onclick="() => _showPassword = !_showPassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-2xl hover:bg-gray-600 rounded-full items-center text-center justify-center">
          👁️‍🗨️
        </button>
      </div>
      
      <button type="submit" disabled="@_isSubmiting"
              class="bg-linear-to-l rounded-2xl shadow-black shadow-lg/40 border-black from-amber-700 to-orange-800 text-white hover:bg-linear-to-r hover:from-green-600 hover:to-[#7B9668] active:from-green-400 active:to-green-600 px-4 py-2 text-xl mt-5 w-full">
        @if (_isSubmiting)
        {
          <span>Connexion en cours ...</span>
        }
        else
        {
          <span>Connexion</span>
        }
      </button>

      <div class="flex p-1 justify-center text-2xl ">
        Pas encore inscrit ?
        <NavLink href="/register" class="text-orange-600 hover:text-[#7B9668] text-center justify-center ml-5">Créer un compte</NavLink>
      </div>

      <div class="p-2 border-gray-300">
        <p class="text-xl text-gray-600 font-semibold mb-3 text-center">Avec No Debts, Good Friends, vous pouvez :</p>
        <ul class="space-y-2 text-xl text-gray-500">
          <li class="flex items-center text-center justify-center gap-2">💰 Suivre vos dépenses partagées facilement</li>
          <li class="flex items-center text-center justify-center gap-2">💰 Savoir qui doit combien, en un coup d'œil</li>
          <li class="flex items-center text-center justify-center gap-2">💰 Gérer votre budget en toute simplicité</li>
        </ul>
      </div>
    </EditForm>
  </div>

  @if (_authResponse is not null)
  {
    // "Faux forms caché pour la connection et le probleme de header deja envoyé"
    <form action="/auth/signin" method="post" id="signin-form">
      <input type="hidden" name="__RequestVerificationToken" value="@_antiforgeryToken"/>
      <input type="hidden" name="userId" value="@_authResponse.Id"/>
      <input type="hidden" name="email" value="@_authResponse.Email"/>
      <input type="hidden" name="pseudo" value="@_authResponse.Pseudo"/>
      <input type="hidden" name="accessToken" value="@_authResponse.AccessToken"/>
      <input type="hidden" name="refreshToken" value="@_authResponse.RefreshToken"/>
    </form>

    <script>
      document.getElementById('signin-form').submit();
    </script>
  }
</div>

@code {
  private bool _showPassword;
  private string? _message;
  private bool _isSubmiting;

  private string? _antiforgeryToken;

  protected override void OnInitialized()
  {
    var tokens = Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext!);
    _antiforgeryToken = tokens.RequestToken;
  }

  private LoginUserModel _model = new()
  {
    Email = "",
    Password = ""
  };

  private AuthUserResponseModel? _authResponse;

  private async Task HandleValidSubmit()
  {
    _isSubmiting = true;

    try
    {
      var response = await UserApiCLient.LoginAsync(_model);

      if (!response.IsSuccessStatusCode)
      {
        _message = "Erreur lors de la connexion";
        return;
      }

      _authResponse = await response.Content.ReadFromJsonAsync<AuthUserResponseModel>();

      if (_authResponse is null)
      {
        _message = "Erreur lors de la connexion";
        return;
      }
    }
    finally
    {
      _isSubmiting = false;
    }
  }

}