@using ndgf.Web.Helpers
@using ndgf.Web.Models.Expense


<div class="flex flex-col md:flex-row gap-1.5 mt-4">
  <div class="w-full md:flex-1 bg-[#93BABC] rounded-2xl p-4 border border-amber-200">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xl">💡</span>
      <h3 class="text-lg font-semibold text-[#46392F]">Remboursements suggérés</h3>
    </div>

    @if (Balance is not null && Balance.SuggestedRepayments.Any())
    {
      <div class="space-y-2">
        @foreach (var repayment in Balance.SuggestedRepayments)
        {
          <div class="flex items-center gap-3 p-3 rounded-xl bg-[#F6E9CC] border border-amber-200">
            <div
              class="w-9 h-9 rounded-full bg-linear-to-t @(UserColorHelper.GetColorForUser(repayment.PayerId)) text-white flex items-center justify-center text-xs font-bold shrink-0">
              @repayment.PayerPseudo[0]@repayment.PayerPseudo[1]
            </div>
            <p class="text-base leading-snug text-[#6E5C4E]">
              <span class="font-semibold">@repayment.PayerPseudo</span> doit
              <span class="font-semibold text-amber-800">@repayment.Amount €</span>
              à <span class="font-semibold">@repayment.ReceiverPseudo</span>
            </p>
          </div>
        }
      </div>
    }
    else
    {
      <p class="text-[#6E5C4E] mb-4 text-lg italic">Tout le monde est à jour, rien à régler.</p>
      @if (IsArchived)
      {
        <h3 class="text-lg font-semibold text-[#8A4529]">Ce groupe a été archivé, impossible de modifier,
          lecture seule uniquement</h3>
      }
    }
  </div>

  <div class="w-full md:flex-1 bg-[#93BABC] rounded-2xl p-3 border border-violet-200">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xl">📊</span>
      <h3 class="text-[#46392F] text-lg font-semibold">Soldes du groupe</h3>
    </div>

    @if (Balance is not null && Balance.Balances.Any())
    {
      <div class="space-y-2">
        @foreach (var balance in Balance.Balances)
        {
          <div class=" flex justify-between items-center p-3 rounded-xl bg-[#F6E9CC] border border-gray-200">
            <p class="text-[#6E5C4E] font-semibold">@balance.Pseudo</p>

            @if (balance.Balance > 0)
            {
              <span
                class="text-sm font-semibold text-[#3D5A45] bg-green-100 px-2 py-1 rounded-full">+@balance.Balance €</span>
            }
            else if (balance.Balance < 0)
            {
              <span
                class="text-sm font-semibold text-[#6B3320] bg-[#E0A88C] px-2 py-1 rounded-full">@balance.Balance €</span>
            }
            else
            {
              <span class="text-sm font-medium text-[#6E5C4E] bg-gray-100 px-2 py-1 rounded-full">À jour</span>
            }
          </div>
        }
      </div>
    }
    else
    {
      <p class="text-gray-500 text-sm italic">Aucun solde à afficher.</p>
    }
  </div>
</div>

@code {
  [Parameter] public GetGroupBalanceResponseModel? Balance { get; set; }
  [Parameter] public bool IsArchived { get; set; }
}